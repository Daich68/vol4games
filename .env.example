# Таблица лидеров — Redis через REST (Upstash / Vercel KV).
# Скопируй в .env.local для локального запуска через `vercel dev`.
# На проде Vercel подставляет эти переменные сам, когда подключишь KV-хранилище.

# Вариант A — Vercel KV (Storage → KV → Connect Project):
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Вариант B — Upstash Redis напрямую (console.upstash.com → REST):
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
